{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Canvas",
  "version": "../package.json",
  "identifier": "dev.agentcanvas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Canvas",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true,
        "shadow": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "\u00a9 2026 Agent Canvas contributors. MIT licensed.",
    "shortDescription": "Run several AI coding agents on one canvas.",
    "longDescription": "Agent Canvas runs AI coding CLIs as real processes on a spatial canvas. Agents discover each other only through connections you draw, share a task board and a common memory, and escalate decisions back to you.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/prayagtushar/agent-canvas/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
