# Normalise line endings on the way into the repository. Without this a
# Windows checkout rewrites every file the first time someone saves one, and
# the next diff is the whole tree.
* text=auto eol=lf

# Except the files Windows itself runs, which want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never treated as text, so git does not try to merge or diff them.
*.png   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary

# Generated by a tool, not written by hand. GitHub collapses these in review
# and leaves them out of the language breakdown, which otherwise reports this
# as a mostly-JSON project.
package-lock.json    linguist-generated=true
src-tauri/Cargo.lock  linguist-generated=true
